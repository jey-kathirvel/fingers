[Unit]
Description=Fingers FastAPI backend
After=network.target postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fingers/backend
EnvironmentFile=/opt/fingers/.env
Environment=PYTHONPATH=/opt/fingers/backend
ExecStart=/opt/fingers/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

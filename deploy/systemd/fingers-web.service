[Unit]
Description=Fingers Next.js frontend
After=network.target fingers-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/fingers/frontend
EnvironmentFile=/opt/fingers/.env
Environment=PORT=3090
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --port 3090 --hostname 127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Fingers environment template — copy to /opt/fingers/.env on the VPS
APP_NAME=Fingers
APP_VERSION=0.1.0
ENVIRONMENT=production
SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

DATABASE_URL=postgresql+psycopg://fingers_user:CHANGE_ME@localhost:5432/fingers_db
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=https://fingers.ads-ai.in
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8090

INITIAL_ADMIN_EMAIL=admin@ads-ai.in
INITIAL_ADMIN_PASSWORD=ChangeMe123!
INITIAL_ADMIN_NAME=Fingers Admin
INITIAL_ORG_NAME=Ads AI
INITIAL_BRAND_NAME=Fingers Demo

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://fingers.ads-ai.in/api
PORT=3090

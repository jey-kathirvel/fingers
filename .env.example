APP_NAME=Fingers
APP_VERSION=0.3.0
ENVIRONMENT=development
API_PREFIX=/api

DATABASE_URL=postgresql+psycopg2://fingers_user:fingers_pass@127.0.0.1:5432/fingers_db
REDIS_URL=redis://127.0.0.1:6379/0

SECRET_KEY=change-me-in-production-fingers-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM=HS256

CORS_ORIGINS=http://localhost:3090,https://fingers.ads-ai.in

SEED_ADMIN_EMAIL=admin@fingers.ads-ai.in
SEED_ADMIN_PASSWORD=FingersAdmin!2026
SEED_ADMIN_NAME=Fingers Admin

API_INTERNAL_URL=http://127.0.0.1:8095

# LLM provider priority: OpenRouter → OpenAI → local engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://fingers.ads-ai.in
OPENROUTER_APP_NAME=Fingers

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional Phase 3 social credentials
# LinkedIn live publishing is enabled when client id/secret are set.
# Meta is deferred for now.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://fingers.ads-ai.in/api/integrations/linkedin/callback
LINKEDIN_API_VERSION=202507
